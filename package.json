{
  "name": "substrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "check:web": "tsc --noEmit -p web/tsconfig.json && biome ci web scripts playwright.config.ts --error-on-warnings",
    "test:browser": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs-required": "node scripts/check-docs-required.mjs",
    "test:checks": "node --test --test-isolation=none scripts/*.test.mjs",
    "format:web": "biome check --write web scripts playwright.config.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lodash": "4.18.1",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
